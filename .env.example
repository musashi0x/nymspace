# App
NEXT_PUBLIC_APP_NAME=Nymspace
NEXT_PUBLIC_PARENT_ENS_NAME=nymspace.eth
NEXT_PUBLIC_CHAIN_ID=11155111

# Sepolia
SEPOLIA_RPC_URL=
NEXT_PUBLIC_SEPOLIA_RPC_URL=

# Base Sepolia
#
# ENSv2 is Sepolia-only, so agent names always live there. The ERC 8004 identity
# registry is deployed at the same address on both networks, and design.md D14
# puts the registration on Base Sepolia because Ethereum Sepolia's Agent0
# subgraph is unserviceable. The ENSIP 25 key therefore encodes chain reference
# 0x014a34 rather than 0xaa36a7 — the only difference between the two.
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# ENSv2 — deployed by ENS, Sepolia
#
# Canonical source: ensdomains/contracts-v2 @ 97a57293f3b4279d94b571e678edb53ce62638f4,
# contracts/docs/addresses/sepolia.md, deployed 2026-07-30. That is the commit
# ensdomains/docs pins for its ENSv2 Deployments page. The addresses in
# ensdomains/namechain (both its Sepolia sets) are a different, older deployment
# and every one of them differs — do not mix the two.
ENSV2_ROOT_REGISTRY_ADDRESS=0x8115186e8f2e0b0281e86ab91f0f48ba90364354
ENSV2_ETH_REGISTRY_ADDRESS=0xbdc85dd5b15d7ecb354cd7cb6f2c50b4f2c4f0e2
ENSV2_ETH_REGISTRAR_ADDRESS=0xa88553f454b77203b0d036a05c894d555eaaa2cc
ENSV2_UNIVERSAL_RESOLVER_ADDRESS=0x4a1817d13e9cf196f471725176355c1234b63c70
ENSV2_VERIFIABLE_FACTORY_ADDRESS=0x10dc6333cdfe1fcef624c6e0a8221b91804cd7ef
ENSV2_USER_REGISTRY_IMPL_ADDRESS=0x624a25d67b59d587752ebec8dded8827dae52050
ENSV2_PERMISSIONED_RESOLVER_IMPL_ADDRESS=0x9eae5c2730a7dd16bdd1dee6421a1b91e3b0365e

# ENSv2 — payment token for .eth registration
#
# ETHRegistrar prices in an ERC 20, not ETH: getRegisterPrice(label, duration,
# paymentToken). MockUSDC and MockDAI are deployed alongside the registrar and
# both expose mint(address,uint256), so they are the testnet faucet.
# MockDAI: 0x5472c5725a00b7ba11f0794a79d08ade6f4683bd
ENSV2_PAYMENT_TOKEN_ADDRESS=0x768f42455a2d082e23ceef7d51e5787c82d67a39

# ENSv2 — deployed by us, outputs of the Day 1 spike
#
# Both are blank until `pnpm --filter @nymspace/ens spike` deploys them, and
# both are proxies the organization owns. PARENT_REGISTRY is the UserRegistry
# wired under the parent label with setSubregistry(); PERMISSIONED_RESOLVER is
# the resolver proxy the organization initialized, which is the only reason it
# can call authorizeTextRoles at all.
ENSV2_PARENT_LABEL=nymspace
ENSV2_PARENT_REGISTRY_ADDRESS=
ENSV2_PERMISSIONED_RESOLVER_ADDRESS=

# ENSv2 — testnet keys
#
# Sepolia only. The organization owns the parent name, the registry proxy, and
# the resolver proxy; the controller is the agent's key and is granted exactly
# one text record. Two separate keys is the whole point — one key proves nothing
# about delegation. Both need Sepolia ETH before the spike runs.
# Never commit a real value; docs/12_SECURITY_MODEL.md.
ENSV2_ORGANIZATION_PRIVATE_KEY=
ENSV2_AGENT_CONTROLLER_PRIVATE_KEY=

# ENSv2 — read-only mode
#
# Set these *instead of* the two keys above to run the API without signing
# authority: every read works, and a write throws with the variable to set.
# Reads need to know which account to check permissions for, not how to sign as
# it, so a teammate, CI, or anyone who cloned the repo can bring the console up
# without the funded signers.
#
# Ignored when both private keys are present — the keys derive these.
ENSV2_ORGANIZATION_ADDRESS=
ENSV2_AGENT_CONTROLLER_ADDRESS=

# ERC 8004
#
# From agent0lab/subgraph config/networks/eth-sepolia.json, each confirmed
# non-empty with eth_getCode. Base Sepolia deploys the identical addresses, so
# the ENSIP 25 key differs only in its chain reference (aa36a7 vs 014a34).
#
# The identity registry is a trusted local input, not something discovery
# returns: Agent0 gives Agent.id as <chainId>:<agentId> and never the registry
# address, while ENSIP 25 needs it as an ERC 7930 interoperable address.
#
# No ValidationRegistry is deployed on either Sepolia network. Validation is
# therefore an optional ranking dimension on testnet and must never render as a
# zero score — an absent dimension scored as zero is invented reputation.
ERC8004_IDENTITY_REGISTRY_ADDRESS=0x8004A818BFB912233c491871b3d84c89A494BD9e
ERC8004_REPUTATION_REGISTRY_ADDRESS=0x8004B663056A597Dffe9eCcC1965A193B7388713
ERC8004_VALIDATION_REGISTRY_ADDRESS=
ERC8004_BASE_SEPOLIA_IDENTITY_REGISTRY_ADDRESS=0x8004A818BFB912233c491871b3d84c89A494BD9e

# An output of `pnpm register:identity`, recorded here the way the spike's proxy
# addresses are. The registry cannot answer "which agent claims this name", so
# without a pointer Gate A would have to walk the id space. The gate still reads
# every assertion from chain and fails if this id claims a different name.
ERC8004_RESEARCH_AGENT_ID=

# The Graph
GRAPH_API_KEY=
GRAPH_AGENT0_SEPOLIA_SUBGRAPH_ID=6wQRC7geo9XYAhckfmfo8kbMRLeWU8KQd3XsJqFKmZLT
GRAPH_AGENT0_BASE_SEPOLIA_SUBGRAPH_ID=4yYAvQLFjBhBtdRCY7eUWo181VNoTSLLFd5M7FXQAi6u

# Which network discovery queries by default. `sepolia` or `base-sepolia`.
#
# ADR 009 asked that adding a second network be a config entry rather than a
# rewrite, and this is that entry. It reads `base-sepolia` because Ethereum
# Sepolia's Agent0 indexer is stuck and serves no entity queries (design.md
# D14); point it back at `sepolia` when that recovers.
GRAPH_DEFAULT_NETWORK=base-sepolia

# LLM — the discovery ranking step
#
# Gemini, decided at task 1.6. The ranking step runs server-side on apps/api so
# the key stays behind the `server-only` guard alongside GRAPH_API_KEY; a
# ranking step in a Next route would put the same key one import mistake away
# from a client bundle.
#
# The model id is pinned in code rather than here on purpose. An environment
# variable that selects a model lets a deploy silently change what the ranking
# explanation is checked against, and docs/13's explanation validator is only
# meaningful against a known model.
GEMINI_API_KEY=

# Privy
#
# Two authorities, not one. `PRIVY_AUTHORIZATION_*` is the **agent's** signing
# key — the one whose spending the policy caps — and `PRIVY_OWNER_*` is the
# organization's, which owns the wallet and is not bound by the agent's cap.
# Privy evaluates only the acting signer's override policy, so which key signs a
# request is what decides which limit applies.
#
# The owner pair is optional, and its absence is a product state rather than a
# misconfiguration: with no key above the agent there is no approval path, so a
# denial offers none. docs/08 forbids simulating an approval system that is not
# implemented, and deriving the affordance from these two variables is how that
# promise survives someone forgetting a feature flag.
#
# `pnpm provision:signers --create-keys` generates the owner key and prints it
# once. Nothing writes it here for you: a script that edits this file is a
# script that can overwrite a key still in use.
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_SECRET=
PRIVY_AUTHORIZATION_KEY_ID=
PRIVY_AUTHORIZATION_PRIVATE_KEY=
PRIVY_POLICY_ID=
PRIVY_AGENT_SIGNER_ID=
PRIVY_OWNER_KEY_ID=
PRIVY_OWNER_PRIVATE_KEY=
PRIVY_OWNER_POLICY_ID=

# Coordination store
#
# Postgres, decided at task 1.6. The store coordinates the product and is not
# the authority for identity, permissions, trust, or policy — docs/09's opening
# line, and the constraint tasks 2.5 and 8.6 test rather than assume.
#
# One variable, because a connection string already carries host, port, user,
# password, and database. Splitting it into five would be five things to get
# wrong in a demo environment.
#
# `docker compose up -d` serves exactly this URL. Port 5433 rather than the
# default, because 5432 is usually already another project's database and a
# connection that lands in the wrong one is worse than a refused connection.
DATABASE_URL=postgresql://nymspace:nymspace@localhost:5433/nymspace

# Demo payments
#
# Amounts are in the **token's base units**, which for USDC means six decimals:
# 5 USDC is 5000000, not 5. The unit is not a detail — an amount written as if
# it were whole tokens executes, returns a transaction hash, and renders as a
# success while moving a millionth of what the screen says.
#
# The token is Circle's Base Sepolia USDC. Leave DEMO_PAYMENT_TOKEN_ADDRESS
# empty to fall back to native ETH, which is the arrangement Gate C first passed
# under and the fallback docs/08's cut line names. Any token other than the
# known USDC deployment needs its symbol and decimals stated too, because a
# guessed decimals figure is wrong by orders of magnitude in the direction that
# still looks plausible.
#
# The four numbers have to sit in a particular order for Gate C to mean
# anything: allowed <= policy limit < denied < wallet balance. The last of those
# is what removes "the wallet was empty" as an explanation for the denial, which
# is the boring cause the gate's control exists to eliminate.
#
#   allowed    5 USDC
#   limit     10 USDC   (seeded by `pnpm provision:wallet`, then read from the
#                        live policy — never displayed from a constant)
#   denied   100 USDC
#   funded   205 USDC   (two denied amounts plus the allowed one; faucet.circle.com)
#
# Gas is separate and still native ETH: an ERC 20 transfer is not gasless, and
# `pnpm provision:wallet` tops the wallet up from the organization key.
DEMO_ALLOWED_PAYMENT_AMOUNT=5000000
DEMO_DENIED_PAYMENT_AMOUNT=100000000
DEMO_PAYMENT_TOKEN_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e
DEMO_PAYMENT_TOKEN_SYMBOL=USDC
DEMO_PAYMENT_TOKEN_DECIMALS=6
DEMO_PAYMENT_RECIPIENT=

# API server (apps/api)
#
# `API_PORT` is the local knob. `PORT` is what a platform injects — Railway
# assigns one per deployment — and `apiConfig()` reads it as the fallback, so
# leave it unset locally and never set it on Railway.
API_PORT=3112
PORT=
WEB_ORIGIN=http://localhost:3111
NEXT_PUBLIC_API_URL=http://localhost:3112

# GitHub activity (apps/api) — all optional. The token only lifts GitHub's
# anonymous rate limit of 60 requests an hour; the endpoint works without it.
GITHUB_TOKEN=
GH_TOKEN=
GITHUB_OWNER=musashi0x
GITHUB_REPO=nymspace
GITHUB_BRANCH=
