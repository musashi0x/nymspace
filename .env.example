# App
NEXT_PUBLIC_APP_NAME=Nymspace
NEXT_PUBLIC_PARENT_ENS_NAME=example.eth
NEXT_PUBLIC_CHAIN_ID=11155111

# Sepolia
SEPOLIA_RPC_URL=
NEXT_PUBLIC_SEPOLIA_RPC_URL=

# ENSv2 — deployed by ENS, Sepolia
#
# Canonical source: ensdomains/contracts-v2 @ 97a57293f3b4279d94b571e678edb53ce62638f4,
# contracts/docs/addresses/sepolia.md, deployed 2026-07-30. That is the commit
# ensdomains/docs pins for its ENSv2 Deployments page. The addresses in
# ensdomains/namechain (both its Sepolia sets) are a different, older deployment
# and every one of them differs — do not mix the two.
ENSV2_ROOT_REGISTRY_ADDRESS=0x8115186e8f2e0b0281e86ab91f0f48ba90364354
ENSV2_ETH_REGISTRY_ADDRESS=0xbdc85dd5b15d7ecb354cd7cb6f2c50b4f2c4f0e2
ENSV2_ETH_REGISTRAR_ADDRESS=0xa88553f454b77203b0d036a05c894d555eaaa2cc
ENSV2_UNIVERSAL_RESOLVER_ADDRESS=0x4a1817d13e9cf196f471725176355c1234b63c70
ENSV2_VERIFIABLE_FACTORY_ADDRESS=0x10dc6333cdfe1fcef624c6e0a8221b91804cd7ef
ENSV2_USER_REGISTRY_IMPL_ADDRESS=0x624a25d67b59d587752ebec8dded8827dae52050
ENSV2_PERMISSIONED_RESOLVER_IMPL_ADDRESS=0x9eae5c2730a7dd16bdd1dee6421a1b91e3b0365e

# ENSv2 — payment token for .eth registration
#
# ETHRegistrar prices in an ERC 20, not ETH: getRegisterPrice(label, duration,
# paymentToken). MockUSDC and MockDAI are deployed alongside the registrar and
# both expose mint(address,uint256), so they are the testnet faucet.
# MockDAI: 0x5472c5725a00b7ba11f0794a79d08ade6f4683bd
ENSV2_PAYMENT_TOKEN_ADDRESS=0x768f42455a2d082e23ceef7d51e5787c82d67a39

# ENSv2 — deployed by us, outputs of the Day 1 spike
#
# Both are blank until `pnpm --filter @nymspace/ens spike` deploys them, and
# both are proxies the organization owns. PARENT_REGISTRY is the UserRegistry
# wired under the parent label with setSubregistry(); PERMISSIONED_RESOLVER is
# the resolver proxy the organization initialized, which is the only reason it
# can call authorizeTextRoles at all.
ENSV2_PARENT_LABEL=
ENSV2_PARENT_REGISTRY_ADDRESS=
ENSV2_PERMISSIONED_RESOLVER_ADDRESS=

# ENSv2 — testnet keys
#
# Sepolia only. The organization owns the parent name, the registry proxy, and
# the resolver proxy; the controller is the agent's key and is granted exactly
# one text record. Two separate keys is the whole point — one key proves nothing
# about delegation. Both need Sepolia ETH before the spike runs.
# Never commit a real value; docs/12_SECURITY_MODEL.md.
ENSV2_ORGANIZATION_PRIVATE_KEY=
ENSV2_AGENT_CONTROLLER_PRIVATE_KEY=

# ERC 8004
#
# From agent0lab/subgraph config/networks/eth-sepolia.json, each confirmed
# non-empty with eth_getCode. Base Sepolia deploys the identical addresses, so
# the ENSIP 25 key differs only in its chain reference (aa36a7 vs 014a34).
#
# The identity registry is a trusted local input, not something discovery
# returns: Agent0 gives Agent.id as <chainId>:<agentId> and never the registry
# address, while ENSIP 25 needs it as an ERC 7930 interoperable address.
#
# No ValidationRegistry is deployed on either Sepolia network. Validation is
# therefore an optional ranking dimension on testnet and must never render as a
# zero score — an absent dimension scored as zero is invented reputation.
ERC8004_IDENTITY_REGISTRY_ADDRESS=0x8004A818BFB912233c491871b3d84c89A494BD9e
ERC8004_REPUTATION_REGISTRY_ADDRESS=0x8004B663056A597Dffe9eCcC1965A193B7388713
ERC8004_VALIDATION_REGISTRY_ADDRESS=
ERC8004_BASE_SEPOLIA_IDENTITY_REGISTRY_ADDRESS=0x8004A818BFB912233c491871b3d84c89A494BD9e

# The Graph
GRAPH_API_KEY=
GRAPH_AGENT0_SEPOLIA_SUBGRAPH_ID=6wQRC7geo9XYAhckfmfo8kbMRLeWU8KQd3XsJqFKmZLT
GRAPH_AGENT0_BASE_SEPOLIA_SUBGRAPH_ID=4yYAvQLFjBhBtdRCY7eUWo181VNoTSLLFd5M7FXQAi6u

# Privy
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_SECRET=
PRIVY_AUTHORIZATION_KEY_ID=
PRIVY_AUTHORIZATION_PRIVATE_KEY=
PRIVY_POLICY_ID=

# Demo
DEMO_ALLOWED_PAYMENT_AMOUNT=
DEMO_DENIED_PAYMENT_AMOUNT=
DEMO_PAYMENT_TOKEN_ADDRESS=
DEMO_PAYMENT_RECIPIENT=

# API server (apps/api)
API_PORT=3112
WEB_ORIGIN=http://localhost:3111
NEXT_PUBLIC_API_URL=http://localhost:3112

# GitHub activity (apps/api) — all optional. The token only lifts GitHub's
# anonymous rate limit of 60 requests an hour; the endpoint works without it.
GITHUB_TOKEN=
GH_TOKEN=
GITHUB_OWNER=musashi0x
GITHUB_REPO=nymspace
GITHUB_BRANCH=
