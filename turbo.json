{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    ".env.example",
    "tsconfig.base.json"
  ],
  "ui": "tui",
  "globalEnv": [
    "API_PORT",
    "BASE_SEPOLIA_RPC_URL",
    "DATABASE_URL",
    "DEMO_ALLOWED_PAYMENT_AMOUNT",
    "DEMO_DENIED_PAYMENT_AMOUNT",
    "DEMO_PAYMENT_RECIPIENT",
    "DEMO_PAYMENT_TOKEN_ADDRESS",
    "ENSV2_AGENT_CONTROLLER_ADDRESS",
    "ENSV2_AGENT_CONTROLLER_PRIVATE_KEY",
    "ENSV2_ETH_REGISTRAR_ADDRESS",
    "ENSV2_ETH_REGISTRY_ADDRESS",
    "ENSV2_ORGANIZATION_ADDRESS",
    "ENSV2_ORGANIZATION_PRIVATE_KEY",
    "ENSV2_PARENT_LABEL",
    "ENSV2_PARENT_REGISTRY_ADDRESS",
    "ENSV2_PAYMENT_TOKEN_ADDRESS",
    "ENSV2_PERMISSIONED_RESOLVER_ADDRESS",
    "ENSV2_PERMISSIONED_RESOLVER_IMPL_ADDRESS",
    "ENSV2_ROOT_REGISTRY_ADDRESS",
    "ENSV2_UNIVERSAL_RESOLVER_ADDRESS",
    "ENSV2_USER_REGISTRY_IMPL_ADDRESS",
    "ENSV2_VERIFIABLE_FACTORY_ADDRESS",
    "ERC8004_BASE_SEPOLIA_IDENTITY_REGISTRY_ADDRESS",
    "ERC8004_IDENTITY_REGISTRY_ADDRESS",
    "ERC8004_REPUTATION_REGISTRY_ADDRESS",
    "ERC8004_RESEARCH_AGENT_ID",
    "ERC8004_VALIDATION_REGISTRY_ADDRESS",
    "GEMINI_API_KEY",
    "GH_TOKEN",
    "GITHUB_BRANCH",
    "GITHUB_OWNER",
    "GITHUB_REPO",
    "GITHUB_TOKEN",
    "GRAPH_AGENT0_BASE_SEPOLIA_SUBGRAPH_ID",
    "GRAPH_AGENT0_SEPOLIA_SUBGRAPH_ID",
    "GRAPH_API_KEY",
    "GRAPH_DEFAULT_NETWORK",
    "NEXT_PUBLIC_API_URL",
    "NEXT_PUBLIC_APP_NAME",
    "NEXT_PUBLIC_CHAIN_ID",
    "NEXT_PUBLIC_ORGANIZATION_ADDRESS",
    "NEXT_PUBLIC_PARENT_ENS_NAME",
    "NEXT_PUBLIC_PRIVY_APP_ID",
    "NEXT_PUBLIC_SEPOLIA_RPC_URL",
    "PRIVY_APP_SECRET",
    "PRIVY_AUTHORIZATION_KEY_ID",
    "PRIVY_AUTHORIZATION_PRIVATE_KEY",
    "PRIVY_POLICY_ID",
    "SEPOLIA_RPC_URL",
    "WEB_ORIGIN"
  ],
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^typecheck"
      ],
      "outputs": []
    },
    "lint": {
      "outputs": []
    },
    "test": {
      "dependsOn": [
        "^test"
      ],
      "outputs": []
    }
  }
}
