    {
      "type": "text",
      "id": "t4",
      "x": 80,
      "y": 100,
      "width": 1200,
      "height": 37,
      "text": "Read off the classes that exist, not the interfaces docs/04 once proposed.\nDomain logic lives only in packages/*; apps/api/src/deps.ts is the only place any of these is built.",
      "originalText": "Read off the classes that exist, not the interfaces docs/04 once proposed.\nDomain logic lives only in packages/*; apps/api/src/deps.ts is the only place any of these is built.",
