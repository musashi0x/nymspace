    },
    {
      "type": "text",
      "id": "t76",
      "x": 86,
      "y": 1459,
      "width": 1180,
      "height": 150,
      "text": "rankAgents \u00b7 validateExplanation \u00b7 validationReachesModel \u00b7 buildLogEntry\nRANKING_MODEL \"gemini-2.5-flash\", keyed by GEMINI_API_KEY\n\nturns the natural-language request into selection criteria, then ranks candidates\nevery citation in its explanation is validated against CITABLE_FIELDS\nmust not invent reputation or capabilities, and must not prefer demo metadata\nRankingProviderError degrades to an unranked list rather than failing the request\nimported straight into the route, so it is the one dependency a test cannot swap",
      "originalText": "rankAgents \u00b7 validateExplanation \u00b7 validationReachesModel \u00b7 buildLogEntry\nRANKING_MODEL \"gemini-2.5-flash\", keyed by GEMINI_API_KEY\n\nturns the natural-language request into selection criteria, then ranks candidates\nevery citation in its explanation is validated against CITABLE_FIELDS\nmust not invent reputation or capabilities, and must not prefer demo metadata\nRankingProviderError degrades to an unranked list rather than failing the request\nimported straight into the route, so it is the one dependency a test cannot swap",
      "fontSize": 15,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "strokeColor": "#64748b",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
