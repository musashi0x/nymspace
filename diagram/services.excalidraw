    {
      "type": "text",
      "id": "c68_t",
      "x": 100,
      "y": 1400,
      "width": 1140,
      "height": 23,
      "text": "rankAgents  \u00b7  @nymspace/graph/ranking  \u2014  the discovery agent",
      "originalText": "rankAgents  \u00b7  @nymspace/graph/ranking  \u2014  the discovery agent",
      "fontSize": 19,
      "fontFamily": 3,
      "textAlign": "center",
      "verticalAlign": "middle",
      "strokeColor": "#374151",
      "backgroundColor": "transparent",
