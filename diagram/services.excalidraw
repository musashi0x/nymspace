    {
      "type": "text",
      "id": "t52",
      "x": 86,
      "y": 959,
      "width": 1180,
      "height": 112,
      "text": "register \u00b7 agentURI \u00b7 ownerOf \u00b7 registrationFile \u00b7 claimsEnsName\n\nBase Sepolia 84532, its own viem client on a separate RPC, the same two keys\nclaimsEnsName is the ENSIP 25 binding read\na private waitUntilReadable sits behind register: a registration is not done when\nits transaction lands, it is done when the registry reads it back",
      "originalText": "register \u00b7 agentURI \u00b7 ownerOf \u00b7 registrationFile \u00b7 claimsEnsName\n\nBase Sepolia 84532, its own viem client on a separate RPC, the same two keys\nclaimsEnsName is the ENSIP 25 binding read\na private waitUntilReadable sits behind register: a registration is not done when\nits transaction lands, it is done when the registry reads it back",
      "fontSize": 15,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "strokeColor": "#64748b",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
