    {
      "type": "text",
      "id": "t16",
      "x": 86,
      "y": 256,
      "width": 1180,
      "height": 93,
      "text": "validates the body with @hono/zod-validator before any service runs\nresolves :id to an agent through the store, 404s when absent\norchestrates service calls and holds no domain logic itself\nHTTPException becomes JSON; anything else is logged and answered 500\nnever constructs a client or derives an EAC resource",
      "originalText": "validates the body with @hono/zod-validator before any service runs\nresolves :id to an agent through the store, 404s when absent\norchestrates service calls and holds no domain logic itself\nHTTPException becomes JSON; anything else is logged and answered 500\nnever constructs a client or derives an EAC resource",
      "fontSize": 15,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "strokeColor": "#64748b",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
