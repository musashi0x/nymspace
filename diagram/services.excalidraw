    {
      "type": "text",
      "id": "c20_t",
      "x": 100,
      "y": 400,
      "width": 1140,
      "height": 23,
      "text": "apps/api/src/deps.ts  \u00b7  the dependency seam",
      "originalText": "apps/api/src/deps.ts  \u00b7  the dependency seam",
      "fontSize": 19,
      "fontFamily": 3,
      "textAlign": "center",
      "verticalAlign": "middle",
      "strokeColor": "#374151",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "angle": 0,
