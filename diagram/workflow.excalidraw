    {
      "type": "text",
      "id": "t228",
      "x": 80,
      "y": 822,
      "width": 1150,
      "height": 56,
      "text": "The two red rows mount no dependencies, on purpose. /health answering through an RPC and a database\nwould report their health rather than its own, and /v1/github/activity is also server-rendered straight\ninto the landing page, so that read never crosses the wire at all.",
      "originalText": "The two red rows mount no dependencies, on purpose. /health answering through an RPC and a database\nwould report their health rather than its own, and /v1/github/activity is also server-rendered straight\ninto the landing page, so that read never crosses the wire at all.",
      "fontSize": 15,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "strokeColor": "#64748b",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "angle": 0,
      "seed": 700230,
      "version": 1,
      "versionNonce": 700232,
      "isDeleted": false,
      "groupIds": [],
      "boundElements": null,
      "link": null,
      "locked": false,
      "containerId": null,
      "lineHeight": 1.25
    },
    {
      "type": "text",
      "id": "t232",
      "x": 80,
      "y": 946,
      "width": 1150,
      "height": 25,
      "text": "ONE WRITE, IN ORDER  \u2014  POST /v1/agents/:id/records",
      "originalText": "ONE WRITE, IN ORDER  \u2014  POST /v1/agents/:id/records",
      "fontSize": 20,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "strokeColor": "#1e40af",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "angle": 0,
      "seed": 700234,
      "version": 1,
