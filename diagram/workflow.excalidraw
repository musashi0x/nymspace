      "id": "t452",
      "x": 666,
      "y": 2234,
      "width": 560,
      "height": 112,
      "text": "one record-scoped grant:\nagent-endpoint[mcp]\nsigns the step 4 write, always\nrefused on agent-context and\nagent-registration by the contract\nholds no registry role at all",
      "originalText": "one record-scoped grant:\nagent-endpoint[mcp]\nsigns the step 4 write, always\nrefused on agent-context and\nagent-registration by the contract\nholds no registry role at all",
