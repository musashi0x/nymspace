{
  "name": "nymspace",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "env:check": "tsx --conditions=react-server scripts/check-env-declarations.ts",
    "conditions:check": "tsx --conditions=react-server scripts/check-server-conditions.ts",
    "check": "pnpm env:check && pnpm conditions:check"
  },
  "devDependencies": {
    "@types/node": "^24",
    "tsx": "^4.20.6",
    "turbo": "^2.5.8",
    "typescript": "^5",
    "vitest": "^5.0.0"
  },
  "packageManager": "pnpm@10.28.0"
}
